{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "create-storage-dir",
            "detail": "",
            "hide": true,
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "mkdir",
                "-p",
                "storage"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [],
            "icon": {
                "id": "note",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "tcb-setup"
            }
        },
        {
            "label": "tcb-setup",
            "detail": "",
            "hide": true,
            "command": "DOCKER_HOST=",
            "type": "shell",
            "runOptions": {
                "runOn": "folderOpen"
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--help"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "create-storage-dir"
            ],
            "icon": {
                "id": "note",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "tcb-setup"
            }
        },
        {
            "label": "tcb-build",
            "detail": "Build the tcbuild.yaml file and generate the custom image",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose build"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [],
            "icon": {
                "id": "tools",
                "color": "terminal.ansiYellow"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "group": "tcb-build"
            }
        },
        {
            "label": "tcb-unpack",
            "detail": "",
            "hide": true,
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose images --remove-storage unpack ${command:tcb.outputTEZIFolder}"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [],
            "icon": {
                "id": "package",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "tcb-deploy"
            }
        },
        {
            "label": "tcb-deploy",
            "detail": "Run the torizoncore-builder deploy command to the default target device",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose deploy --remote-host ${config:torizon_ip} --remote-username ${config:torizon_login} --remote-password '${config:torizon_psswd}' --reboot"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "tcb-unpack"
            ],
            "icon": {
                "id": "export",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "tcb-deploy"
            }
        },
        {
            "label": "tcb-isolate",
            "detail": "Run the torizoncore-builder isolate command to the default target device",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose isolate --remote-host ${config:torizon_ip} --remote-username ${config:torizon_login} --remote-password '${config:torizon_psswd}' --changes-directory ${config:change-dir}"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "export",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "tcb-deploy"
            }
        },
        {
            "label": "tcb-platform-push-ostree",
            "detail": "Run the torizoncore-builder platform push command to torizon.io cloud",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose platform push --credentials credentials.zip --package-name __change__ --package-version ${command:tcb.getNextPackageVersion} __container__"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "group": "cloud-related"
            }
        },
        {
            "label": "tcb-dt-status",
            "detail": "Run the torizoncore-builder command to show the current device tree of the image, if any.",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose dt status"
