        {
            "label": "tcb-dto-list",
            "detail": "Run the torizoncore-builder command to scan subdirectory device-trees/overlays of TorizonCore Builder's working directory for overlay source files that are declared to be compatible to the current device tree.",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "VSCODE_CMD": "--verbose dto list"
                }
            },
            "args": [
                "source",
                "./.conf/tcb-env-setup.sh",
                "-s",
                "${workspaceFolder}/storage",
                "-t",
                "${config:tcb.version}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [],
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "group": "cloud-related"
            }
        },
        {
            "label": "platform-update-fleet",
            "detail": "This task will trigger the update of the fleet in the\nTorizon Platform with the latest version\nof the application published to the platform.",
            "command": "DOCKER_HOST=",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PLATFORM_CLIENT_ID": "${command:tcb.clientId}",
                    "PLATFORM_CLIENT_SECRET": "${command:tcb.clientSecret}"
                }
            },
            "args": [
                "xonsh",
                "./.conf/torizon-io.xsh",
                "update",
                "fleet",
                "latest",
                "__change__",
                "${command:tcb.fleetName}"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "cloud-upload",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "group": "cloud-related"
            }
        },
        {
            "label": "fill-pipeline-settings",
            "detail": "This task will fill the properties that are needed to be\nset in the .vscode/settings.json to correctly\nrun the GitHub Actions or GitLab CI pipelines.",
            "command": "echo",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DOCKER_REGISTRY": "${command:docker_registry}",
                    "DOCKER_LOGIN": "${command:docker_login}",
                    "DOCKER_PSSWD": "${command:docker_password}",
                    "DOCKER_TAG": "${command:docker_tag}",
                    "TCB_CLIENTID": "${command:tcb.clientId}",
                    "TCB_CLIENTSECRET": "${command:tcb.clientSecret}",
                    "TCB_PACKAGE": "__change__",
                    "TCB_FLEET": "${command:tcb.fleetName}",
                    "TORIZON_ARCH": "${command:torizon_arch}"
                }
            },
            "args": [
                "-e",
                "\"✅ github-actions-settings done\n",
                "\n",
                "'⚠️  ENV VARIABLES NEED TO BE SET IN CI/CD PLATFORM'\n",
                "\tDOCKER_PSSWD\n",
                "\tPLATFORM_CLIENT_ID\n",
                "\tPLATFORM_CLIENT_SECRET\n",
                "\tPLATFORM_CREDENTIALS\n\""
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "notebook",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "group": "cloud-related"
            }
        },
        {
            "label": "validate-pipeline-settings",
            "detail": "",
            "hide": true,
            "command": "xonsh",
            "type": "process",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "DOCKER_REGISTRY": "${command:docker_registry}",
                    "DOCKER_LOGIN": "${command:docker_login}",
                    "DOCKER_PSSWD": "${command:docker_password}",
                    "DOCKER_TAG": "${command:docker_tag}",
                    "TCB_CLIENTID": "${command:tcb.clientId}",
                    "TCB_CLIENTSECRET": "${command:tcb.clientSecret}",
                    "TCB_PACKAGE": "__change__",
                    "TCB_FLEET": "${command:tcb.fleetName}",
                    "TORIZON_CI_SETTINGS_FILE": ".vscode/settings.json"
                }
            },
            "args": [
                ".conf/check-ci-env.xsh"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
            ],
            "icon": {
                "id": "notebook",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "validate-json-files",
            "detail": "Validate the JSON files formatting on the workspace",
            "command": "xonsh",
            "type": "shell",
            "args": [
                "${workspaceFolder}/scripts/validate-json.xsh"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "id": "notebook",
                "color": "terminal.ansiYellow"
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": true,
                "panel": "dedicated"
            }
